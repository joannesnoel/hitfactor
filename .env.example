# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=hitfactor
POSTGRES_USER=hitfactor
POSTGRES_PASSWORD=hitfactor_dev_password

# Backend
PORT=3000
NODE_ENV=development
JWT_ISSUER=hitfactor
JWT_AUDIENCE=hitfactor-app
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# CORS - comma-separated origins allowed to call the API
CORS_ORIGIN=http://localhost:9000

# PowerSync
POWERSYNC_URL=http://localhost:8080
POWERSYNC_PUBLIC_KEY=  # Set after generating RS256 keys

# Frontend
VITE_API_URL=http://localhost:3000
VITE_POWERSYNC_URL=http://localhost:8080
